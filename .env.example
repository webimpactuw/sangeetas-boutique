# Copy to .env.local and fill in real values.

# --- Supabase (auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Resend (orders, bookings, payment instructions) ---
# Get API key: https://resend.com/api-keys
# Production: verify a domain in Resend and use e.g. orders@yourdomain.com (not onboarding@resend.dev)
RESEND_API_KEY=re_xxxxxxxx
SANJI_ORDER_EMAIL=sanjimunoth@gmail.com
RESEND_FROM_EMAIL=onboarding@resend.dev
# Production site URL (no trailing slash) — used in approve links in Sanji's emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Random 32+ character string — required for "Approve & send payment" in order emails
ORDER_APPROVAL_SECRET=change-me-to-a-long-random-string
# PayPal.me username if she has one (optional — overrides email links)
PAYPAL_ME_USERNAME=
# PayPal business email (used for payment links + QR when no PayPal.me username)
PAYPAL_BUSINESS_EMAIL=sanjimunoth@gmail.com
NEXT_PUBLIC_PAYPAL_BUSINESS_EMAIL=sanjimunoth@gmail.com

# --- Sanity CMS (optional for local content; has defaults) ---
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production

# --- Dev only: show /dev/emails preview on production (remove after handoff) ---
# ENABLE_EMAIL_PREVIEW=true
