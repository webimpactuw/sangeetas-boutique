# Copy to .env.local and fill in real values.

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Where order inquiries are delivered (Sanji)
SANJI_ORDER_EMAIL=sanji@example.com

# Sender (dev: onboarding@resend.dev; prod: verified domain)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Public site URL (approve links in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# HMAC secret for "Approve & send payment" links (generate: openssl rand -hex 32)
ORDER_APPROVAL_SECRET=change-me-to-a-long-random-string

# Sanji's PayPal.me username (not the club — e.g. "sanji" for paypal.me/sanji/10.00USD)
PAYPAL_ME_USERNAME=your-paypal-username
